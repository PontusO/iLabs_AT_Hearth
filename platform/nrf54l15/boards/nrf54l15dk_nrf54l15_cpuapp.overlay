/* The AT link. On the DK this is the second VCOM (uart20 is the
 * console/shell UART, wired to zephyr,console in the board's own
 * dts); the Ophelia-IV board definition points it at the module's
 * host UART instead. uart21 IS a real SoC node (uart@c7000, disabled
 * by default, same as uart30), but the DK board's own pinctrl file
 * routes pins only for uart20 and uart30; uart21 has no board-level
 * pin routing to bring up, so uart30 stands in for the brief's uart21
 * placeholder.
 */
/ {
    chosen {
        hearth,at-uart = &uart30;
    };
};

&uart30 {
    status = "okay";
    current-speed = <115200>;
};

/* The SoC dtsi reserves 68 KB of the 256 KB physical SRAM for the
 * cpuflpr (VPR) coprocessor (nordic/nrf54l15.dtsi: cpuapp_sram defaults
 * to 188 KB); this core-sanity build never runs anything on cpuflpr.
 * Real CHIP server bring-up (Task 2, BT+OpenThread actually started)
 * overflows the default 188 KB region; reclaim the full 256 KB, same
 * as Nordic's own nrf54l15dk overlay in
 * nrf/samples/matter/template/boards/nrf54l15dk_nrf54l15_cpuapp.overlay
 * ("restore full RRAM and SRAM space").
 */
&cpuapp_sram {
    reg = <0x20000000 DT_SIZE_K(256)>;
    ranges = <0x0 0x20000000 DT_SIZE_K(256)>;
};
