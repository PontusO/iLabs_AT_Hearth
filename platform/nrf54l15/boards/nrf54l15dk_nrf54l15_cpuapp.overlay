/* The AT link. On the DK this is the second VCOM (uart20 is the
 * console/shell UART, wired to zephyr,console in the board's own
 * dts); the Ophelia-IV board definition points it at the module's
 * host UART instead. uart21 IS a real SoC node (uart@c7000, disabled
 * by default, same as uart30), but the DK board's own pinctrl file
 * routes pins only for uart20 and uart30; uart21 has no board-level
 * pin routing to bring up, so uart30 stands in for the brief's uart21
 * placeholder.
 */
/ {
    chosen {
        hearth,at-uart = &uart30;
    };
};

&uart30 {
    status = "okay";
    current-speed = <115200>;
};
