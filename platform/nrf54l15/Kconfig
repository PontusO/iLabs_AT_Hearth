#
# Without this file, Zephyr auto-generates a trivial app Kconfig root
# (mainmenu + source "Kconfig.zephyr") and nothing else. That default
# never reaches the CHIP module's own Kconfig.features/Kconfig.defaults
# fragments (they are not rsourced from chip-module/Kconfig itself, only
# from each sample's own top-level Kconfig, mirrored here), so options
# such as CHIP_CRYPTO_PSA's "default y" never apply and CHIP falls back
# to the legacy mbedTLS crypto backend, which this nrf_security build
# does not expose (mbedtls_ecp_muladd, mbedtls_pkcs5_pbkdf2_hmac: no
# declaration, build fails). Sourcing these two fragments is what makes
# the PSA-backed crypto path (CHIPCryptoPALPSA.cpp) the one actually
# built.
#
mainmenu "Hearth nRF54L15 Matter Platform"

source "$(ZEPHYR_CONNECTEDHOMEIP_MODULE_DIR)/config/nrfconnect/chip-module/Kconfig.features"
source "$(ZEPHYR_CONNECTEDHOMEIP_MODULE_DIR)/config/nrfconnect/chip-module/Kconfig.defaults"
source "Kconfig.zephyr"
