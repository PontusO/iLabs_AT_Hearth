# Silabs toolchain for the Hearth MG24 port. Source before building:
#
#   source platform/silabs/toolchain.env
#
# Installed 2026-09-17 with Silicon Labs' SLT-CLI (the Silicon Labs Tool), not
# by cloning: since Simplicity SDK 2025.12 the SDK is delivered as Conan
# packages through SLT and is no longer published on GitHub (the public
# SiliconLabs/simplicity_sdk repository stops at v2025.6.3). SLT itself is a
# standalone public download, no login:
#
#   https://www.silabs.com/documents/public/software/slt-cli-1.2.1-linux-x64.zip
#
#   slt version:  1.2.1-101   ($SLT_BIN/slt --version)
#   recipe:       ~/silabs/pkg.slt          (the pinned versions below)
#   lock file:    ~/silabs/pkg.lock         (versions plus Conan revisions)
#   installs:     ~/.silabs/slt/installs/   (conan/p/... and archive/...)
#
# Reinstall on another machine with:
#
#   slt install -f ~/silabs/pkg.lock --check-updates=false --non-interactive
#
# Package directories are resolved through `slt where` rather than written out,
# because the Conan cache directory names are a per-machine hash. The values
# this file resolved to on 2026-09-17 are recorded beside each line.

# ---------------------------------------------------------------- versions ---
# Pinned pair, from the design spec's "SiSDK 2025.12 + Silabs Matter 2.8.0-1.5":
#
#   simplicity-sdk     2025.12.3
#   matter_extension   2.8.1     (Silicon Labs Matter 2.8.1-1.5)
#
# 2.8.1 rather than 2.8.0 because 2.8.1 is the extension release paired with the
# newest 2025.12 patch: `slt list matter_extension -v 2.8.1 --deps` names
# simplicity-sdk 2025.12.3, while 2.8.0 names 2025.12.1. Both are the Matter
# 1.5 line the spec asks for.
#
#   gcc-arm-none-eabi  12.2.rel1  -> arm-none-eabi-gcc 12.2.1 20221205
#                                    (Arm GNU Toolchain 12.2.Rel1, Build arm-12.24)
#   cmake              3.30.2
#   ninja              1.12.1
#   zap                2026.06.17 (the extension's minimum is v2025.12.02)
#   slc-cli            6.0.23
#   java21             21.0.6     (slc-cli's JRE; must be first on PATH)
#   commander          1.24.3     -> Simplicity Commander 1v24p3b1989
#   python             3.10.3     (pulled in as an slc-cli dependency)
#   wiseconnect        4.0.2      (a matter_extension dependency; Wi-Fi only,
#                                  unused by this Thread port)
#
# GN and Ninja were the 2.3.x-era build path. Silicon Labs Matter 2.4 and later
# build through slc-cli and make; there is no gn_silabs_example.sh in the
# extension. Ninja is installed because the recipe carries it, not because this
# port uses it.

export SLT_BIN="$HOME/silabs/bin"
export PATH="$SLT_BIN:$PATH"

# ------------------------------------------------------------------- paths ---
# Resolved 2026-09-17 to:
#   simplicity-sdk     ~/.silabs/slt/installs/conan/p/simpl35774a752829c/p
#   matter_extension   ~/.silabs/slt/installs/conan/p/matte8bada656e9e76/p
#   gcc-arm-none-eabi  ~/.silabs/slt/installs/conan/p/gcc-a442105b5c2637/p
#   cmake              ~/.silabs/slt/installs/conan/p/cmake1c02712053792/p
#   ninja              ~/.silabs/slt/installs/conan/p/ninja1b9fed093d653/p
#   slc-cli            ~/.silabs/slt/installs/archive/slc-cli-v6.0.23/slc_cli
#   java21             ~/.silabs/slt/installs/archive/java21-v21.0.6/linux.x86_64_21.0.6
#   commander          ~/.silabs/slt/installs/archive/commander
#   zap                ~/.silabs/slt/installs/archive/zap
export SISDK_ROOT="$(slt where simplicity-sdk | tail -1)"
export MATTER_EXT_INSTALL="$(slt where matter_extension | tail -1)"
export ARM_GCC_DIR="$(slt where gcc-arm-none-eabi | tail -1)"
export CMAKE_DIR="$(slt where cmake | tail -1)"
export NINJA_DIR="$(slt where ninja | tail -1)"
export SLC_CLI_DIR="$(slt where slc-cli | tail -1)"
export JAVA_HOME="$(slt where java21 | tail -1)/jre"
export COMMANDER_DIR="$(slt where commander | tail -1)"
export ZAP_DIR="$(slt where zap | tail -1)"

# slc-cli needs its own Java first on PATH (SLT setup guide, step 6), and the
# extension's slc/build.sh finds ZAP through one of these two variables.
export ZAP_INSTALL_PATH="$ZAP_DIR"
export STUDIO_ADAPTER_PACK_PATH="$ZAP_DIR"

# The ninja package puts its binary at the package root, not in bin/.
export PATH="$JAVA_HOME/bin:$SLC_CLI_DIR:$ARM_GCC_DIR/bin:$CMAKE_DIR/bin:$NINJA_DIR:$COMMANDER_DIR:$ZAP_DIR:$PATH"

# ------------------------------------------------- the build working copy ---
# slc/build.sh writes its out/ tree next to the .slcp it is given, which would
# put build output inside the Conan package cache, where an `slt update` can
# drop it without warning. So the extension is copied out of the cache once and
# built from the copy, with the two SDK roots it expects symlinked in:
#
#   cp -a "$MATTER_EXT_INSTALL" "$MATTER_EXT_ROOT"
#   ln -sfn "$SISDK_ROOT"  "$MATTER_EXT_ROOT/third_party/simplicity_sdk"
#   ln -sfn "$(slt where wiseconnect|tail -1)" "$MATTER_EXT_ROOT/third_party/wifi_sdk"
#
# SISDK_ROOT above is honoured by slc/build.sh directly, so the simplicity_sdk
# symlink is belt and braces; the wifi_sdk one is not, build.sh passes that path
# to slc unconditionally.
export MATTER_EXT_ROOT="$HOME/silabs/matter_extension-2.8.1"
