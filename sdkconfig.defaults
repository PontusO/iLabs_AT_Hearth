CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

#enable BT
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

#disable BT connection reattempt
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n

#enable lwip ipv6 autoconfig
CONFIG_LWIP_IPV6_AUTOCONFIG=y

# Use a custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

# Enable chip shell
CONFIG_ENABLE_CHIP_SHELL=y

CONFIG_ENABLE_WIFI_AP=n

#enable lwIP route hooks
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y

# Endpoint composition (C1): the host declares up to MT_COMP_MAX_ENDPOINTS (24)
# endpoints over AT+MTEP, so the dynamic endpoint cap must be at least that.
# Was 2, inherited from the esp-matter light example this project started from,
# which silently refused every endpoint past the first. Raised from 16 to 24
# for the composed-appliance round (parent endpoints, spec 2.3).
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=24

# Button
CONFIG_BUTTON_PERIOD_TIME_MS=20
CONFIG_BUTTON_LONG_PRESS_TIME_MS=5000

# disable softap by default
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# app_main calls into CHIP, so it needs a CHIP-sized stack. IDF's 3584-byte
# default is not one, and the shortfall is not subtle: opening a commissioning
# window from mt_boot_window_policy() (spec 3.12.1) drags in mDNS advertising
# and overflowed it outright.
#
#   Guru Meditation Error: Core 0 panic'ed (Stack protection fault).
#   Detected in task "main"
#   Stack pointer: 0x40837fc0   Stack bounds: 0x40837fc4 - 0x40838fc0
#
# The same call via AT+MTCOMMISSION had always worked, because that path runs
# on the AT parser task (MT_PARSER_TASK_STACK, 6144). Identical function, two
# stacks, only one of them adequate.
#
# 8192 to match CONFIG_CHIP_TASK_STACK_SIZE rather than merely clearing the
# observed overflow: app_main also rebuilds the endpoint composition and runs
# esp_matter::start(), so it deserves the same headroom as the task whose work
# it is doing. Costs ~4.6 KB of RAM once.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Keep the BLE stack resident after commissioning. CHIP defaults this to y,
# which deinitialises BLE on successful commissioning and skips BLE init at
# boot on an already-provisioned device, calling esp_bt_mem_release() to hand
# the controller memory back to the heap.
#
# That default makes AT+MTCOMMISSION a lie. The command is specified (spec
# section 3.5) for reopening a window on an already-commissioned device, which
# is precisely the state in which there is no BLE left to advertise with: it
# returns OK, raises +MTEVT:0 and advertises to nobody. That was defect D1,
# found on hardware 2026-07-28.
#
# Measured cost of turning it off, on hardware: 35,800 bytes, leaving 173 KB of
# free heap with BLE resident against 209 KB without. Cheap for the command to
# mean what it says, and it is not a speculative configuration: the device
# already runs in exactly this state for the first seconds of every boot and
# throughout every commissioning. The firmware logs both figures on every boot
# (see kBLEDeinitialized in main.cpp) so the trade can be re-checked after an
# SDK bump rather than taken on trust from this comment.
#
# Consequence to be aware of: the BLE radio stays initialised for the life of
# the device. It does not advertise unless a commissioning window is open, but
# it is powered.
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=n

# No Matter OTA Requestor. It needs two app slots to write an image into, and
# partitions.csv now has one: updates are a host-driven serial flash from the
# RP2350, not an on-device download (FIRMWARE_UPDATE_SPEC.md). Left on, the
# image would carry a downloader that cannot succeed and would advertise an
# OTA Requestor cluster to the fabric that no controller could usefully drive.
CONFIG_ENABLE_OTA_REQUESTOR=n

# Enable HKDF in mbedtls
CONFIG_MBEDTLS_HKDF_C=y

# Increase LwIP IPv6 address number to 6 (MAX_FABRIC + 1)
# unique local addresses for fabrics(MAX_FABRIC), a link local address(1)
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6

# Exclude unused clusters to optimize flash and memory usage. FAN_CONTROL,
# OCCUPANCY_SENSING, THERMOSTAT, WINDOW_COVERING, SWITCH, TEMPERATURE_CONTROL
# and DOOR_LOCK were excluded here too until the device-type expansion (mt_devtypes.cpp)
# started creating those clusters: excluded, cluster::create() links but the
# plugin-server init and SetDefaultDelegate symbols for that cluster are
# absent from the chip component archive, and the final link fails with
# "undefined reference to <Cluster>PluginServerInitCallback" /
# "...SetDefaultDelegate" (SWITCH: SwitchServer::Instance() /
# ::OnInitialPress() and MatterSwitchPluginServerInitCallback(), the same
# shape one level down, since Switch's server is a class instance rather
# than a delegate). Re-enabling a SUPPORT_*_CLUSTER flag here is what
# actually compiles that cluster's server implementation into the chip
# component; the esp_matter config
# struct exists either way, so the failure only shows up at link time.
CONFIG_SUPPORT_ACCOUNT_LOGIN_CLUSTER=n
CONFIG_SUPPORT_ACTIVATED_CARBON_FILTER_MONITORING_CLUSTER=n
CONFIG_SUPPORT_APPLICATION_BASIC_CLUSTER=n
CONFIG_SUPPORT_APPLICATION_LAUNCHER_CLUSTER=n
CONFIG_SUPPORT_AUDIO_OUTPUT_CLUSTER=n
CONFIG_SUPPORT_BOOLEAN_STATE_CONFIGURATION_CLUSTER=n
CONFIG_SUPPORT_BRIDGED_DEVICE_BASIC_INFORMATION_CLUSTER=n
CONFIG_SUPPORT_CAMERA_AV_SETTINGS_USER_LEVEL_MANAGEMENT_CLUSTER=n
CONFIG_SUPPORT_CARBON_DIOXIDE_CONCENTRATION_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_CARBON_MONOXIDE_CONCENTRATION_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_CHANNEL_CLUSTER=n
# CHIME_CLUSTER: re-enabled, task C6 (seven-type batch) creates a chime
# endpoint (mt_devtypes.cpp's mk_chime()). Pulls src/app/clusters/chime-server
# (ChimeCluster.cpp) into the esp_matter component's SRC_DIRS
# (get_supported_cluster_dirs(), esp_matter's CMakeLists.txt); without it,
# ESPMatterChimeClusterServerInitCallback (always compiled, since
# data_model_provider/clusters is unconditional) would try to instantiate
# ChimeCluster with no definition to link against.
CONFIG_SUPPORT_CLOSURE_CONTROL_CLUSTER=n
CONFIG_SUPPORT_CLOSURE_DIMENSION_CLUSTER=n
CONFIG_SUPPORT_COMMISSIONER_CONTROL_CLUSTER=n
CONFIG_SUPPORT_CONTENT_LAUNCHER_CLUSTER=n
CONFIG_SUPPORT_CONTENT_CONTROL_CLUSTER=n
CONFIG_SUPPORT_CONTENT_APP_OBSERVER_CLUSTER=n
CONFIG_SUPPORT_DEVICE_ENERGY_MANAGEMENT_CLUSTER=n
CONFIG_SUPPORT_DEVICE_ENERGY_MANAGEMENT_MODE_CLUSTER=n
CONFIG_SUPPORT_DIAGNOSTIC_LOGS_CLUSTER=n
CONFIG_SUPPORT_DISHWASHER_ALARM_CLUSTER=n
CONFIG_SUPPORT_DISHWASHER_MODE_CLUSTER=n
# MICROWAVE_OVEN_MODE_CLUSTER: re-enabled, RVC + Microwave batch task 2. This
# and RVC_RUN_MODE/RVC_CLEAN_MODE below all map to the SAME cluster
# directory, src/app/clusters/mode-base-server (cluster_dir.cmake): the
# abstract ModeBase cluster's Instance/Delegate is shared by every concrete
# derivation (RvcRunMode, RvcCleanMode, MicrowaveOvenMode, DishwasherMode,
# etc; see the "DISHWASHER_MODE" line above, still excluded since this
# firmware never creates that endpoint). Any one of the three re-enables the
# directory; all three are listed here because main.cpp's
# HearthModeBaseDelegate/mt_matter_modebase_set (task 2) call
# ModeBase::Instance methods directly, unconditionally, before any thunk in
# mt_devtypes.cpp creates a concrete cluster (Tasks 3-4), so leaving any of
# the three excluded is inert now but would silently reintroduce the same
# "undefined reference to ModeBase::Instance::<method>" link failure the
# CHIME_CLUSTER/MODE_SELECT_CLUSTER comments above document the general
# shape of, the moment a rebase or edit removed one of the others.
CONFIG_SUPPORT_ECOSYSTEM_INFORMATION_CLUSTER=n
# ELECTRICAL_ENERGY_MEASUREMENT_CLUSTER / ELECTRICAL_POWER_MEASUREMENT_CLUSTER
# (and POWER_TOPOLOGY_CLUSTER below): re-enabled, energy round A task 2.
# main.cpp's HearthEpmDelegate subclasses ElectricalPowerMeasurement::Delegate
# and the EEM bridge calls the electrical-energy-measurement-server free
# functions unconditionally, so leaving either disabled is a link failure
# (undefined reference), the MICROWAVE_OVEN_CONTROL_CLUSTER shape below, not
# a silent no-op. Each maps to its own dedicated source directory in
# cluster_dir.cmake, shared with nothing else this firmware builds.
CONFIG_SUPPORT_ELECTRICAL_ENERGY_MEASUREMENT_CLUSTER=y
CONFIG_SUPPORT_ELECTRICAL_POWER_MEASUREMENT_CLUSTER=y
CONFIG_SUPPORT_ENERGY_EVSE_CLUSTER=n
CONFIG_SUPPORT_ENERGY_EVSE_MODE_CLUSTER=n
CONFIG_SUPPORT_ENERGY_PREFERENCE_CLUSTER=n
CONFIG_SUPPORT_FAULT_INJECTION_CLUSTER=n
CONFIG_SUPPORT_FIXED_LABEL_CLUSTER=n
CONFIG_SUPPORT_FORMALDEHYDE_CONCENTRATION_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_HEPA_FILTER_MONITORING_CLUSTER=n
CONFIG_SUPPORT_ICD_MANAGEMENT_CLUSTER=n
CONFIG_SUPPORT_KEYPAD_INPUT_CLUSTER=n
CONFIG_SUPPORT_LAUNDRY_WASHER_MODE_CLUSTER=n
CONFIG_SUPPORT_LOCALIZATION_CONFIGURATION_CLUSTER=n
CONFIG_SUPPORT_LOW_POWER_CLUSTER=n
CONFIG_SUPPORT_MEDIA_INPUT_CLUSTER=n
CONFIG_SUPPORT_MEDIA_PLAYBACK_CLUSTER=n
# MICROWAVE_OVEN_CONTROL_CLUSTER: re-enabled, RVC + Microwave batch task 4,
# mt_devtypes.cpp's mk_microwave_oven(). Unlike MICROWAVE_OVEN_MODE_CLUSTER
# above (which rides free on the mode-base-server directory RVC's clusters
# already re-enabled), this cluster has its own dedicated source directory
# (src/app/clusters/microwave-oven-control-server, cluster_dir.cmake) shared
# with nothing else this firmware builds: main.cpp's HearthMwocDelegate
# subclasses MicrowaveOvenControl::Delegate/Instance, so leaving this
# disabled is a link failure (undefined reference to
# MicrowaveOvenControl::Instance::<method>), not a silent no-op.
CONFIG_SUPPORT_MICROWAVE_OVEN_CONTROL_CLUSTER=y
CONFIG_SUPPORT_MESSAGES_CLUSTER=n
# MODE_SELECT_CLUSTER: re-enabled, task C3 (seven-type batch) creates a
# mode_select endpoint (mt_devtypes.cpp's mk_mode_select()).
CONFIG_SUPPORT_NITROGEN_DIOXIDE_CONCENTRATION_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_SAMPLE_MEI_CLUSTER=n
# POWER_TOPOLOGY_CLUSTER: re-enabled, energy round A task 2, see the
# ELECTRICAL_*_MEASUREMENT_CLUSTER comment above. HearthPtopDelegate
# subclasses PowerTopology::Delegate and the SDK's
# PowerTopologyDelegateInitCB news a PowerTopology::Instance, so this too is
# a link failure when disabled.
CONFIG_SUPPORT_POWER_TOPOLOGY_CLUSTER=y
# OPERATIONAL_STATE_CLUSTER: re-enabled, task C4 (seven-type batch) creates
# dish_washer/laundry_washer/laundry_dryer endpoints (mt_devtypes.cpp's
# mk_dish_washer()/mk_laundry_washer()/mk_laundry_dryer()), all three wiring
# the base OperationalState cluster (0x0060).
# OPERATIONAL_STATE_OVEN_CLUSTER / OVEN_MODE_CLUSTER: re-enabled, composed
# appliance round task 4. A Temperature Controlled Cabinet composed under an
# Oven gets OvenCavityOperationalState (0x0048) and OvenMode (0x0049)
# hand-rolled onto it (mt_devtypes.cpp's mt_cabinet_add_heater()), and
# main.cpp constructs chip::app::Clusters::OvenCavityOperationalState::
# Instance and a ModeBase::Instance for them. Both flags map to directories
# other re-enabled clusters already pull in (cluster_dir.cmake:
# OPERATIONAL_STATE_OVEN -> src/app/clusters/operational-state-server, the
# same directory OPERATIONAL_STATE_CLUSTER above pulls in; OVEN_MODE ->
# src/app/clusters/mode-base-server, the same one MICROWAVE_OVEN_MODE and
# the two RVC mode flags pull in), so re-enabling them changes nothing about
# what is compiled TODAY. They are listed here for the reason the
# MICROWAVE_OVEN_MODE_CLUSTER comment above gives for its own siblings: inert
# now, but the moment a rebase or edit disabled whichever flag is currently
# carrying the directory, the link failure would surface on these clusters
# with nothing in this file pointing at why.
CONFIG_SUPPORT_OPERATIONAL_STATE_RVC_CLUSTER=n
CONFIG_SUPPORT_OZONE_CONCENTRATION_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_PM10_CONCENTRATION_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_PM1_CONCENTRATION_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_PM2_5_CONCENTRATION_MEASUREMENT_CLUSTER=n
# POWER_SOURCE_CLUSTER: re-enabled, task C5 (seven-type batch) creates a
# power_source endpoint (mt_devtypes.cpp's mk_power_source()). Distinct from
# POWER_SOURCE_CONFIGURATION_CLUSTER below, an unrelated deprecated cluster
# this firmware does not use and leaves disabled.
CONFIG_SUPPORT_POWER_SOURCE_CONFIGURATION_CLUSTER=n
CONFIG_SUPPORT_RADON_CONCENTRATION_MEASUREMENT_CLUSTER=n
# REFRIGERATOR_ALARM_CLUSTER / REFRIGERATOR_AND_TEMPERATURE_CONTROLLED_CABINET_MODE_CLUSTER:
# re-enabled, composed appliance round task 3 creates a refrigerator endpoint
# (mt_devtypes.cpp's mk_refrigerator()), which wires both clusters. Left
# disabled, the RefrigeratorAlarm server methods this firmware's
# mt_matter_alarm_set() fridge branch calls (main.cpp) link-fail (undefined
# reference to RefrigeratorAlarmServer::Instance() and friends,
# MatterRefrigeratorAlarmPluginServerInitCallback()), the same link-time-only
# failure mode CONFIG_SUPPORT_MICROWAVE_OVEN_CONTROL_CLUSTER's comment above
# describes: cluster_dir.cmake gates which src/app/clusters/*-server
# directory actually gets compiled into libCHIP.a.
# RVC_CLEAN_MODE_CLUSTER / RVC_RUN_MODE_CLUSTER: re-enabled, RVC + Microwave
# batch task 2. See the MICROWAVE_OVEN_MODE_CLUSTER comment above: all three
# pull in the same src/app/clusters/mode-base-server directory, and this
# file's own main.cpp additions reference chip::app::Clusters::ModeBase::
# Instance methods unconditionally, ahead of the endpoint thunks Tasks 3-4
# add.
CONFIG_SUPPORT_SERVICE_AREA_CLUSTER=n
# SMOKE_CO_ALARM_CLUSTER: re-enabled, task C5 (seven-type batch) creates a
# smoke_co_alarm endpoint (mt_devtypes.cpp's mk_smoke_co_alarm()).
CONFIG_SUPPORT_SOFTWARE_DIAGNOSTICS_CLUSTER=n
CONFIG_SUPPORT_TARGET_NAVIGATOR_CLUSTER=n
CONFIG_SUPPORT_THERMOSTAT_USER_INTERFACE_CONFIGURATION_CLUSTER=n
CONFIG_SUPPORT_THREAD_BORDER_ROUTER_MANAGEMENT_CLUSTER=n
CONFIG_SUPPORT_THREAD_NETWORK_DIRECTORY_CLUSTER=n
CONFIG_SUPPORT_TIME_FORMAT_LOCALIZATION_CLUSTER=n
# TIME_SYNCHRONIZATION_CLUSTER: not re-enabled for its own sake. Water valve
# (mt_devtypes.cpp's mk_water_valve(), seven-type batch task C2) pulled it in
# as a link-time dependency of a cluster we DO create:
# valve-configuration-and-control-cluster.cpp's SetValveLevel() references
# chip::app::Clusters::TimeSynchronization::TimeSynchronizationServer::
# Instance() inside a #ifdef ZCL_USING_TIME_SYNCHRONIZATION_CLUSTER_SERVER
# block, and that macro is defined unconditionally by esp_matter's own
# bundled zap_common/zap-generated/gen_config.h (not gated on this repo's
# Kconfig at all), so enabling VALVE_CONFIGURATION_AND_CONTROL alone leaves
# the reference with nothing to link against: "undefined reference to
# TimeSynchronizationServer::Instance()". The TimeSync feature bit is never
# set on the valve endpoint (no config_t field exists to opt in, see
# AT_MT_SPEC.md 3.19), so the branch that calls it never actually runs; this
# lift exists purely to satisfy the linker.
CONFIG_SUPPORT_TIMER_CLUSTER=n
CONFIG_SUPPORT_TVOC_CONCENTRATION_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_UNIT_TESTING_CLUSTER=n
CONFIG_SUPPORT_USER_LABEL_CLUSTER=n
CONFIG_SUPPORT_WAKE_ON_LAN_CLUSTER=n
CONFIG_SUPPORT_LAUNDRY_WASHER_CONTROLS_CLUSTER=n
CONFIG_SUPPORT_LAUNDRY_DRYER_CONTROLS_CLUSTER=n
CONFIG_SUPPORT_WIFI_NETWORK_MANAGEMENT_CLUSTER=n
CONFIG_SUPPORT_WATER_HEATER_MANAGEMENT_CLUSTER=n
CONFIG_SUPPORT_WATER_HEATER_MODE_CLUSTER=n
CONFIG_SUPPORT_ELECTRICAL_GRID_CONDITIONS_CLUSTER=n
CONFIG_SUPPORT_COMMODITY_PRICE_CLUSTER=n
CONFIG_SUPPORT_METER_IDENTIFICATION_CLUSTER=n
CONFIG_SUPPORT_UNIT_LOCALIZATION_CLUSTER=n
CONFIG_SUPPORT_COMMODITY_METERING_CLUSTER=n
CONFIG_SUPPORT_COMMODITY_TARIFF_CLUSTER=n
CONFIG_SUPPORT_PUSH_AV_STREAM_TRANSPORT_CLUSTER=n
