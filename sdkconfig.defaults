CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

#enable BT
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

#disable BT connection reattempt
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n

#enable lwip ipv6 autoconfig
CONFIG_LWIP_IPV6_AUTOCONFIG=y

# Use a custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

# Enable chip shell
CONFIG_ENABLE_CHIP_SHELL=y

CONFIG_ENABLE_WIFI_AP=n

#enable lwIP route hooks
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y

# Endpoint composition (C1): the host declares up to MT_COMP_MAX_ENDPOINTS (16)
# endpoints over AT+MTEP, so the dynamic endpoint cap must be at least that.
# Was 2, inherited from the esp-matter light example this project started from,
# which silently refused every endpoint past the first.
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=16

# Button
CONFIG_BUTTON_PERIOD_TIME_MS=20
CONFIG_BUTTON_LONG_PRESS_TIME_MS=5000

# disable softap by default
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# app_main calls into CHIP, so it needs a CHIP-sized stack. IDF's 3584-byte
# default is not one, and the shortfall is not subtle: opening a commissioning
# window from mt_boot_window_policy() (spec 3.12.1) drags in mDNS advertising
# and overflowed it outright.
#
#   Guru Meditation Error: Core 0 panic'ed (Stack protection fault).
#   Detected in task "main"
#   Stack pointer: 0x40837fc0   Stack bounds: 0x40837fc4 - 0x40838fc0
#
# The same call via AT+MTCOMMISSION had always worked, because that path runs
# on the AT parser task (MT_PARSER_TASK_STACK, 6144). Identical function, two
# stacks, only one of them adequate.
#
# 8192 to match CONFIG_CHIP_TASK_STACK_SIZE rather than merely clearing the
# observed overflow: app_main also rebuilds the endpoint composition and runs
# esp_matter::start(), so it deserves the same headroom as the task whose work
# it is doing. Costs ~4.6 KB of RAM once.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Keep the BLE stack resident after commissioning. CHIP defaults this to y,
# which deinitialises BLE on successful commissioning and skips BLE init at
# boot on an already-provisioned device, calling esp_bt_mem_release() to hand
# the controller memory back to the heap.
#
# That default makes AT+MTCOMMISSION a lie. The command is specified (spec
# section 3.5) for reopening a window on an already-commissioned device, which
# is precisely the state in which there is no BLE left to advertise with: it
# returns OK, raises +MTEVT:0 and advertises to nobody. That was defect D1,
# found on hardware 2026-07-28.
#
# Measured cost of turning it off, on hardware: 35,800 bytes, leaving 173 KB of
# free heap with BLE resident against 209 KB without. Cheap for the command to
# mean what it says, and it is not a speculative configuration: the device
# already runs in exactly this state for the first seconds of every boot and
# throughout every commissioning. The firmware logs both figures on every boot
# (see kBLEDeinitialized in main.cpp) so the trade can be re-checked after an
# SDK bump rather than taken on trust from this comment.
#
# Consequence to be aware of: the BLE radio stays initialised for the life of
# the device. It does not advertise unless a commissioning window is open, but
# it is powered.
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=n

# No Matter OTA Requestor. It needs two app slots to write an image into, and
# partitions.csv now has one: updates are a host-driven serial flash from the
# RP2350, not an on-device download (FIRMWARE_UPDATE_SPEC.md). Left on, the
# image would carry a downloader that cannot succeed and would advertise an
# OTA Requestor cluster to the fabric that no controller could usefully drive.
CONFIG_ENABLE_OTA_REQUESTOR=n

# Enable HKDF in mbedtls
CONFIG_MBEDTLS_HKDF_C=y

# Increase LwIP IPv6 address number to 6 (MAX_FABRIC + 1)
# unique local addresses for fabrics(MAX_FABRIC), a link local address(1)
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6

# Exclude unused clusters to optimize flash and memory usage. FAN_CONTROL,
# OCCUPANCY_SENSING, THERMOSTAT, WINDOW_COVERING, SWITCH and TEMPERATURE_CONTROL
# were excluded here too until the device-type expansion (mt_devtypes.cpp)
# started creating those clusters: excluded, cluster::create() links but the
# plugin-server init and SetDefaultDelegate symbols for that cluster are
# absent from the chip component archive, and the final link fails with
# "undefined reference to <Cluster>PluginServerInitCallback" /
# "...SetDefaultDelegate" (SWITCH: SwitchServer::Instance() /
# ::OnInitialPress() and MatterSwitchPluginServerInitCallback(), the same
# shape one level down, since Switch's server is a class instance rather
# than a delegate). Re-enabling a SUPPORT_*_CLUSTER flag here is what
# actually compiles that cluster's server implementation into the chip
# component; the esp_matter config
# struct exists either way, so the failure only shows up at link time.
CONFIG_SUPPORT_ACCOUNT_LOGIN_CLUSTER=n
CONFIG_SUPPORT_ACTIVATED_CARBON_FILTER_MONITORING_CLUSTER=n
CONFIG_SUPPORT_AIR_QUALITY_CLUSTER=n
CONFIG_SUPPORT_APPLICATION_BASIC_CLUSTER=n
CONFIG_SUPPORT_APPLICATION_LAUNCHER_CLUSTER=n
